{
  // === makefile standards
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "~/fastnas/cpip",
        "${workspaceFolder}/ut/**",
        "~/.arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "~/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "~/.arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard"
      ],
      "defines": ["__AVR_ATmega328P__", "F_CPU=16000000L", "ARDUINO=10810", "ARDUINO_AVR_UNO", "ARDUINO_ARCH_AVR"],
      "compilerPath": "/usr/bin/clang",
      "cStandard": "c23",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-clang-x64",
      "configurationProvider": "ms-vscode.makefile-tools",
      "mergeConfigurations": true
    },
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/**",
        "~/fastnas/cpip",
        "${workspaceFolder}/ut/**",
        "~/Library/Arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "~/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "~/Library/Arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard"
      ],
      "defines": ["__AVR_ATmega328P__", "F_CPU=16000000L", "ARDUINO=10810", "ARDUINO_AVR_UNO", "ARDUINO_ARCH_AVR"],
      "compilerPath": "/opt/homebrew/opt/llvm/bin/clang",
      "cStandard": "c23",
      "cppStandard": "c++20",
      "intelliSenseMode": "macos-clang-arm64",
      "configurationProvider": "ms-vscode.makefile-tools",
      "mergeConfigurations": true
    },
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/**",
        "y:/cpip",
        "${workspaceFolder}/ut/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard"
      ],
      "defines": ["__AVR_ATmega328P__", "F_CPU=16000000L", "ARDUINO=10810", "ARDUINO_AVR_UNO", "ARDUINO_ARCH_AVR"],
      "compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
      "cStandard": "c23",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-gcc-x64",
      "configurationProvider": "ms-vscode.makefile-tools",
      "mergeConfigurations": true
    }
  ],
  "version": 4
}
