#! /usr/bin/env bash

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo 'ERR  script must be sourced, e.g. "source do_env"'
else
  if [[ -f tools/xplat_utils/zpm_common.sh ]]; then
    # file is local, use it
    # shellcheck disable=SC1091
    source tools/xplat_utils/zpm_common.sh
  else
    # otherwise, use global one

    # uncomment to debug
    # zpm set-params
    eval "$(zpm set-params)"
    # shellcheck disable=SC1091
    source "$XP_CMN_XPLAT_DIR/zpm_common.sh"
  fi

  zpm_activate_env
  if [[ $1 != quiet ]]; then
    echo 'OK   use "deactivate" to exit python venv'
  fi
fi
