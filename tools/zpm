if [[ "$1" = "xplat-install" ]]; then
  xplat_install
  # at this point: the repo exists and XPLAT_LOCAL_DIR is there
  exit 0
fi

set_branch quiet
set_params

if [[ "$1" = "set-params" ]]; then
  echo "export XPLAT_BRANCH='$XPLAT_BRANCH'"
  echo "export XP_CMN_MAIN='$XP_CMN_MAIN'"
  echo "export XP_CMN_DIR='$XP_CMN_DIR'"
  echo "export XP_CMN_XPLAT_DIR='$XP_CMN_XPLAT_DIR'"
  echo "export XP_CMN_VENV_DIR='$XP_CMN_VENV_DIR'"
  exit 0
fi

if [[ "$1" = "env-install" ]]; then
  "$XPLAT_LOCAL_DIR/zpm_env_install" "$@"
  exit 0
fi

if [[ ! -d "$XPLAT_LOCAL_DIR" ]]; then
  log_err "dir does exist: $XPLAT_LOCAL_DIR"
  log_err "move to a project directory"
  exit 0
fi

if [[ ! -L "$XPLAT_LOCAL_DIR" ]]; then
  log_err "dir is not a softlink: $XPLAT_LOCAL_DIR"
  log_err "run 'zpm xplat-install'"
  exit 0
fi

"$XPLAT_LOCAL_DIR/zpm_ubu_main" "$@"
